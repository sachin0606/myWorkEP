<?xml version="1.0"?>
<configuration>
  <appSettings>
    <add key="FactoryName" value="DeXin.EPG.DALFactory.SQLServerFactory" />
    <add key="Language" value="en-US" />
    <add key="LanguageUI" value="en" />
    <add key="LogPath" value="c:\EPGlog" />
    <add key="LogLevel" value="DEBUG" />
    <add key="DefaultMessage" value="ERROR!" />
    <add key="PageSize" value="25" />
    <add key="SystemTitle" value="EPG" />
  </appSettings>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.0"/>
  </startup>
</configuration>
