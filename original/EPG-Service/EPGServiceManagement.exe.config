<?xml version="1.0"?>
<configuration>
  <appSettings>
    <!-- 生产的数据库底层 -->
    <add key="FactoryName" value="DeXin.EPG.DALFactory.SQLServerFactory"/>
    <!--日期货币格式等-->
    <add key="Language" value=""/>
    <!--资源文件UI-->
    <add key="LanguageUI" value=""/>
    <!-- EPG文本日志路径-->
    <add key="LogPath" value="c:\EPGServerManagelog"/>
    <!-- 日志级别-->
    <add key="LogLevel" value="DEBUG"/>
    <!-- 默认消息提示 -->
    <add key="DefaultMessage" value="ERROR!"/>
    <!--每页页数-->
    <add key="PageSize" value="25"/>
    <add key="HeartFrequnecy" value="10"/>
    <!-- 提示消息标题栏显示文字 -->
    <add key="SystemTitle" value="EPG"/>
  </appSettings>
<startup><supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.0"/></startup></configuration>
